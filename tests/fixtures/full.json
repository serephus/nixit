{
  "repos": {
    "everything": {
      "name": "everything",
      "owner": "octocat",
      "description": "desc",
      "homepage": "https://example.com",
      "topics": ["a", "b"],
      "visibility": "private",
      "features": {
        "wiki": { "enable": false },
        "issues": { "enable": false },
        "projects": { "enable": false },
        "discussions": { "enable": true }
      },
      "is_template": true,
      "is_archived": false,
      "allow_forking": false,
      "pull": {
        "merge": {
          "enable": false,
          "commit_title": "pr_title",
          "commit_message": "pr_body"
        },
        "squash": {
          "enable": true,
          "commit_title": "commit_or_pr_title",
          "commit_message": "commit_messages"
        },
        "rebase": { "enable": false },
        "auto_merge": true,
        "delete_branch_on_merge": true,
        "update_branch": true,
        "web_commit_signoff_required": true
      },
      "actions": {
        "enable": true,
        "policy": "selected",
        "selected": {
          "github_owned": true,
          "verified": false,
          "patterns": ["actions/*"]
        },
        "default_token_permissions": "write",
        "allow_pr_approval": true
      },
      "branch_protection": {
        "main": {
          "required_linear_history": true,
          "enforce_admins": true,
          "allow_force_pushes": false,
          "allow_deletions": false,
          "block_creations": true,
          "required_conversation_resolution": true,
          "lock_branch": false,
          "allow_fork_syncing": true,
          "required_signatures": true,
          "required_status_checks": {
            "strict": true,
            "contexts": ["ci"]
          },
          "required_pull_request_reviews": {
            "dismiss_stale_reviews": true,
            "require_code_owner_reviews": true,
            "required_approving_review_count": 2,
            "require_last_push_approval": true
          }
        }
      },
      "rulesets": {
        "main": {
          "name": "main",
          "target": "branch",
          "enforcement": "active",
          "conditions": {
            "ref_name": {
              "include": ["~DEFAULT_BRANCH"],
              "exclude": ["refs/heads/dev"]
            }
          },
          "bypass_actors": [
            {
              "actor_id": 5,
              "actor_type": "repository_role",
              "bypass_mode": "always"
            }
          ],
          "rules": [
            { "type": "deletion" },
            { "type": "required_linear_history" },
            {
              "type": "pull_request",
              "parameters": {
                "required_approving_review_count": 1,
                "dismiss_stale_reviews_on_push": true,
                "require_code_owner_review": false,
                "require_last_push_approval": false,
                "required_review_thread_resolution": true
              }
            }
          ]
        }
      }
    }
  }
}
